---
import { getNav, getContact, paths, type Lang } from "../data";
import Button from "./Button.astro";

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const nav = getNav(lang);
const contact = getContact(lang);
const p = paths[lang];
const currentPath = Astro.url.pathname;
const ctaHref = `mailto:${contact.email}`;

const links = [
  { href: p.home, label: nav.home },
  { href: p.about, label: nav.about },
  { href: p.work, label: nav.work },
  { href: p.contact, label: nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-charcoal/8 bg-ivory/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4 lg:px-8">
    <a href={p.home} class="font-serif text-xl tracking-tight">
      growth <span class="italic text-gradient">by Marta</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
      {
        links.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "text-sm font-medium transition-colors hover:text-coral",
                isActive ? "text-charcoal" : "text-charcoal/70",
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <a
        href={alternatePath}
        class="rounded-full border border-charcoal/15 px-3 py-1.5 text-xs font-bold tracking-wider text-charcoal/70 transition-colors hover:border-charcoal/40 hover:text-charcoal"
      >
        {nav.langSwitchLabel}
      </a>
      <Button href={ctaHref} class="text-sm px-5 py-2.5">{nav.cta}</Button>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="flex h-10 w-10 items-center justify-center rounded-full text-charcoal md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label={nav.menuOpen}
      data-label-open={nav.menuOpen}
      data-label-close={nav.menuClose}
    >
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>
</header>

<!-- Rendered as a sibling of <header>, not a child: the header's
     backdrop-blur creates a containing block for fixed descendants, which
     would otherwise clip this full-height overlay to the header's own box. -->
<div
  id="mobile-menu"
  class="fixed inset-x-0 top-[65px] bottom-0 z-40 hidden flex-col bg-ivory md:hidden"
>
  <nav class="flex flex-1 flex-col gap-1 overflow-y-auto px-6 py-8" aria-label="Mobile">
    {
      links.map((link) => (
        <a
          href={link.href}
          class="border-b border-charcoal/8 py-4 font-serif text-2xl"
        >
          {link.label}
        </a>
      ))
    }

    <div class="mt-8 flex items-center gap-4">
      <a
        href={alternatePath}
        class="rounded-full border border-charcoal/15 px-4 py-2 text-xs font-bold tracking-wider text-charcoal/70"
      >
        {nav.langSwitchLabel}
      </a>
      <Button href={ctaHref} class="flex-1">{nav.cta}</Button>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("flex");
    menu?.classList.toggle("hidden", isOpen);
    menu?.classList.toggle("flex", !isOpen);
    iconOpen?.classList.toggle("hidden", !isOpen);
    iconClose?.classList.toggle("hidden", isOpen);
    toggle?.setAttribute("aria-expanded", String(!isOpen));
    toggle?.setAttribute(
      "aria-label",
      (isOpen ? toggle.dataset.labelOpen : toggle.dataset.labelClose) ?? "",
    );
    document.body.classList.toggle("overflow-hidden", !isOpen);
  });

  // Close the mobile menu automatically if the viewport grows past the
  // mobile breakpoint (e.g. rotating a tablet), so it can't get stuck open.
  const mq = window.matchMedia("(min-width: 768px)");
  mq.addEventListener("change", (e) => {
    if (e.matches) {
      menu?.classList.add("hidden");
      menu?.classList.remove("flex");
      iconOpen?.classList.remove("hidden");
      iconClose?.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      document.body.classList.remove("overflow-hidden");
    }
  });
</script>
