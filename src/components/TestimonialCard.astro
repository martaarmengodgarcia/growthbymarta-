---
import { Image } from "astro:assets";
import pedro from "../assets/testimonials/pedro.png";
import david from "../assets/testimonials/david.jpg";
import jaime from "../assets/testimonials/jaime.jpg";
import joel from "../assets/testimonials/joel.jpg";
import carola from "../assets/testimonials/carola.jpg";
import { renderEmphasis } from "../lib/richText";

const photos = { pedro, david, jaime, joel, carola };

interface Props {
  name: string;
  role: string;
  photo: keyof typeof photos;
  quotes: string[];
  /** Tailwind bg-* class cycling through the brand palette — a light,
   * per-card signature detail rather than a repeat of the value-card style. */
  accent?: string;
}

const { name, role, photo, quotes, accent = "bg-coral" } = Astro.props;
---

<div class="flex w-[300px] shrink-0 snap-start flex-col rounded-3xl border border-charcoal/10 bg-white p-7 shadow-sm sm:w-[360px]">
  <div class="flex items-center gap-3.5">
    <Image
      src={photos[photo]}
      alt={name}
      width={192}
      height={192}
      quality={90}
      class="h-16 w-16 shrink-0 rounded-full object-cover"
    />
    <div class="min-w-0">
      <p class="truncate font-serif text-lg leading-tight text-charcoal">{name}</p>
      <p class="truncate text-xs text-charcoal/50">{role}</p>
      <span class:list={["mt-1.5 block h-0.5 w-8 rounded-full", accent]} />
    </div>
  </div>

  <div class="mt-5 space-y-3 border-t border-charcoal/8 pt-5 text-sm leading-relaxed text-charcoal/70">
    {
      quotes.map((quote) => {
        const paragraphs = quote.split("\n\n");
        return (
          <blockquote class="space-y-2.5">
            {paragraphs.map((paragraph, i) => (
              <p>
                {i === 0 && <span class="text-coral">“</span>}
                {renderEmphasis(paragraph).map((chunk) =>
                  chunk.bold ? (
                    <strong class="font-semibold text-charcoal">{chunk.text}</strong>
                  ) : (
                    chunk.text
                  ),
                )}
                {i === paragraphs.length - 1 && <span class="text-coral">”</span>}
              </p>
            ))}
          </blockquote>
        );
      })
    }
  </div>
</div>
