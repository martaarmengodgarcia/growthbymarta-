---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GradientOrb from "../GradientOrb.astro";
import { getWork, getSite, getNav, paths, type Lang } from "../../data";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const otherLang: Lang = lang === "es" ? "en" : "es";
const t = getWork(lang);
const site = getSite(lang);
const nav = getNav(lang);
const p = paths[lang];

const entries = (await getCollection("work", (entry) => entry.id.startsWith(`${lang}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  lang={lang}
  title={`${nav.work} — ${site.metaTitle}`}
  description={site.metaDescription}
  alternatePath={paths[otherLang].work}
>
  <section class="relative overflow-hidden">
    <GradientOrb class="-top-24 -left-32 h-[26rem] w-[26rem] opacity-40" />
    <div class="relative mx-auto max-w-6xl px-6 pb-8 pt-16 sm:pt-24 lg:px-8 lg:pt-28">
      <h1 class="text-4xl sm:text-5xl">{t.title}</h1>
      <p class="mt-5 max-w-2xl text-lg text-charcoal/70">{t.intro}</p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-12 lg:px-8 lg:py-16">
    <div class="grid gap-8 lg:grid-cols-2">
      {
        entries.map((entry) => {
          const slug = entry.id.split("/").slice(1).join("/");
          const href = `${p.work}${slug}/`;
          return (
            <a
              href={href}
              class="group flex flex-col overflow-hidden rounded-[2rem] border border-charcoal/8 bg-white/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-charcoal/10"
            >
              <div class="relative aspect-[16/10] w-full overflow-hidden bg-sand/50">
                {entry.data.image ? (
                  <Image
                    src={entry.data.image}
                    alt={entry.data.title}
                    width={640}
                    height={400}
                    quality={90}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                ) : (
                  <div class="gradient-orb absolute inset-8 rounded-full opacity-60" />
                )}
                {entry.data.pending && (
                  <span class="absolute right-4 top-4 rounded-full bg-charcoal/80 px-3 py-1 text-xs font-medium text-ivory backdrop-blur-sm">
                    {t.pendingLabel}
                  </span>
                )}
              </div>
              <div class="flex flex-1 flex-col p-8">
                {entry.data.context && (
                  <p class="eyebrow text-charcoal/40">{entry.data.context}</p>
                )}
                <h2 class="mt-3 text-2xl">{entry.data.title}</h2>
                {entry.data.tools && (
                  <p class="mt-3 text-sm text-charcoal/50">{entry.data.tools}</p>
                )}
                <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-coral">
                  {t.readCase}
                  <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
